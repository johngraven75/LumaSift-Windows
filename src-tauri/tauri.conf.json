{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumaSift",
  "version": "0.1.0",
  "identifier": "com.lumasift.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LumaSift",
        "width": 1280,
        "height": 860,
        "minWidth": 940,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "wix": { "language": ["en-US"] },
      "nsis": { "installerMode": "currentUser" }
    }
  }
}
